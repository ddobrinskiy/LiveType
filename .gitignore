# Build output
.gradle/
.kotlin/
**/build/
worker/node_modules/
worker/.wrangler/

# Secrets — never commit. Path-independent on purpose: a stray copy of
# .dev.vars in any directory must stay untracked.
.dev.vars
*.dev.vars
local.properties

# Release signing: path + password for the keystore. The keystore itself is
# kept outside the repo entirely (~/.secrets/livetype/release.jks).
keystore.properties
*.jks
*.keystore

# Personal vocabulary in the clear. Only the age-encrypted copy
# (data/keywords.txt.age) is committed — see scripts/keywords-*.sh.
data/keywords.txt

# Prebuilt APKs are distributed via GitHub Releases, not tracked in git.
*.apk

# Agent worktrees are created inside the repo; they are never part of it.
.claude/worktrees/

# IDE / OS
.idea/
*.iml
.DS_Store
