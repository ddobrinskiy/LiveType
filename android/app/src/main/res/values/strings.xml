    <string name="status_connecting_openai">Connecting to OpenAI…</string>
    <string name="status_listening">Speak — text appears as it is recognised</string>
    <!--
        Android gives the live microphone to one client at a time. When another
        app wins it, our recording keeps running but only receives silence, so
        say so instead of pretending to listen. Recovery is automatic.
    -->
    <string name="status_mic_in_use">Another app is using the microphone — dictation is paused</string>
