<?xml version="1.0" encoding="utf-8"?>
<!--
    Default locale: English. Any device locale other than Russian falls back
    here automatically. Russian lives in values-ru/strings.xml.
-->
<resources>
    <string name="app_name" translatable="false">LiveType</string>
    <string name="ime_name" translatable="false">LiveType Voice Input</string>
    <string name="app_tagline">Voice input via OpenAI gpt-live-transcribe</string>

    <!-- Keyboard status line -->
    <!-- status_ready is shown only once the OpenAI socket is actually open. -->
    <string name="status_ready">Ready to dictate</string>
    <string name="status_not_connected">Not connected — tap the microphone</string>
    <string name="status_password_field">Dictation is disabled in password fields</string>
    <string name="status_getting_key">Getting a temporary key…</string>
    <string name="status_connecting_openai">Connecting to OpenAI…</string>
    <string name="status_listening">Speak — text appears as it is recognised</string>
    <!--
        Android gives the live microphone to one client at a time. When another
        app wins it, our recording keeps running but only receives silence, so
        say so instead of pretending to listen. Recovery is automatic.
    -->
    <string name="status_mic_in_use">Another app is using the microphone</string>
    <string name="status_finishing">Finishing the phrase…</string>
    <string name="status_done">Done</string>
    <!--
        Shown instead of status_done when the recording ceiling stopped the
        phrase rather than the user. Not an error — the audio was committed and
        the text inserted exactly as a tap on stop would have done — but the
        recording ended without the user asking, so it is drawn red and bold and
        carries its own ⚠️ here in the string. That emoji is why the state does
        NOT pass warning=true: the separate warning ImageView would then say the
        same thing twice. %1$s is the configured limit, e.g. "3 minutes".
    -->
    <string name="status_stopped_time_limit">⚠️ Stopped after %1$s — recording limit reached</string>
    <string name="status_no_speech">No speech recognised</string>
    <!--
        Cancel abandons the phrase, not the session: the socket stays open and
        the state is READY, so the line has to say both "that one is gone" and
        "you can start again right now". Not an error, so no red and no icon.
    -->
    <string name="status_cancelled">Cancelled — ready to dictate</string>
    <string name="status_error">Error</string>
    <string name="status_setup_needed">Setup required</string>

    <!-- Keyboard errors -->
    <string name="error_field_unavailable">Dictation is not available in this field</string>
    <string name="error_no_mic_permission">Open LiveType settings and allow the microphone</string>
    <string name="error_not_configured">Set the Worker URL and device secret in settings</string>
    <string name="error_token_failed">Could not get a key</string>
    <string name="error_openai_closed">The OpenAI connection closed</string>
    <string name="error_mic_start">Could not start the microphone</string>
    <string name="error_closed_before_commit">The connection closed before the phrase was sent</string>

    <!-- Keyboard controls -->
    <string name="action_cancel">Cancel</string>
    <string name="action_settings">Settings</string>
    <string name="cd_previous_keyboard">Switch back to the previous keyboard</string>
    <string name="cd_start_dictation">Start dictation</string>
    <string name="cd_stop_dictation">Finish dictation</string>
    <string name="cd_connecting">Connecting</string>
    <string name="cd_transcribing">Transcribing</string>
    <string name="cd_newline">Insert a line break</string>
    <string name="cd_backspace">Delete the previous character</string>
    <!--
        Paste re-inserts the last recognised phrase, which is held in memory
        for five minutes and never written anywhere. The button is disabled
        while there is nothing to insert.
    -->
    <string name="cd_paste">Insert the last recognised phrase</string>

    <!-- Connection indicators. indicator_openai is a brand name, not translated. -->
    <string name="indicator_server">Token server</string>
    <string name="indicator_openai" translatable="false">OpenAI Realtime</string>
    <string name="connection_ok">Successfully connected</string>
    <string name="connection_error">Error loading</string>
    <string name="connection_loading">Connecting…</string>
    <string name="connection_toast" translatable="false">%1$s: %2$s</string>

    <!-- Settings screen -->
    <string name="action_allow_mic">Allow microphone</string>
    <string name="action_enable_livetype">Enable LiveType</string>
    <string name="action_pick_keyboard">Choose keyboard</string>
    <string name="section_connection">Connection</string>
    <string name="section_recognition">Recognition</string>
    <!--
        Worker picker. Debug builds only, but the strings live here (and in
        values-ru) like any other: MissingTranslation does not care which build
        type reads a key.
    -->
    <string name="label_endpoint_mode">Which worker</string>
    <string name="endpoint_mode_prod">Production worker</string>
    <string name="endpoint_mode_dev">Local worker over adb reverse</string>
    <string name="endpoint_mode_custom">Custom URL</string>
    <!-- Wraps the name of a mode that cannot be picked yet, so the greyed-out
         row says why instead of leaving the reader to guess. -->
    <string name="endpoint_mode_not_deployed">%1$s — not deployed yet</string>
    <string name="label_worker_endpoint">Worker token endpoint</string>
    <string name="label_device_secret">Device secret</string>
    <string name="label_languages">Expected languages, comma separated</string>
    <string name="label_context">Context</string>
    <string name="label_keywords">Terms, one per line</string>
    <!--
        Recording ceiling. Shown in every build, not just debug: forgetting to
        tap stop costs money on any phone.
    -->
    <string name="label_max_recording">Stop recording automatically after</string>
    <string name="note_max_recording">OpenAI charges for every second recorded, so a dictation left running costs money. The phrase is still finished normally and the text inserted.</string>
    <!-- Both the dropdown rows and the %1$s of status_stopped_time_limit. -->
    <plurals name="recording_limit_minutes">
        <item quantity="one">%1$d minute</item>
        <item quantity="other">%1$d minutes</item>
    </plurals>
    <string name="hint_endpoint" translatable="false">https://your-worker.workers.dev/token</string>
    <string name="hint_device_secret" translatable="false">DEVICE_SECRET</string>
    <string name="checkbox_return_keyboard">Return to the previous keyboard after dictation</string>
    <string name="action_save_settings">Save settings</string>
    <string name="privacy_note">You do not enter your main OpenAI API key here. It is stored only in the Cloudflare Worker. LiveType keeps no dictation history.</string>
    <string name="error_need_url">An HTTPS or HTTP URL is required</string>
    <string name="error_secret_short">Use a random secret of at least 16 characters</string>
    <string name="error_need_language">Specify at least one language</string>
    <string name="toast_settings_saved">Settings saved</string>
    <string name="permission_granted">✓ Microphone access granted</string>
    <string name="permission_missing">Allow the app to use the microphone first.</string>

    <!--
        Billing section. Every number shown here is computed by the worker; the
        app only renders what it is handed. billing_unknown is the placeholder
        that keeps "we could not find out" distinct from "zero".
    -->
    <string name="section_billing">Spending</string>
    <string name="billing_unknown" translatable="false">—</string>
    <string name="billing_price">%1$s · %2$s per minute</string>
    <string name="billing_price_unknown">Price unknown</string>
    <string name="billing_price_estimated">This price is an estimate: OpenAI does not publish a token price for this model, so the amounts below are approximate.</string>
    <string name="billing_window_today">Today</string>
    <string name="billing_window_7d">Last 7 days, today included</string>
    <string name="billing_window_30d">Last 30 days, today included</string>
    <string name="billing_source">Source: %1$s · %2$s</string>
    <string name="billing_note">Counts only the dictation this app reported, by whole local days. It is a meter, not an OpenAI invoice.</string>
    <string name="billing_loading">Loading spending…</string>
    <string name="billing_not_configured">Fill in the Worker endpoint and the device secret above, then save, to see spending.</string>
    <string name="billing_error_network">Could not reach the Worker. Check that it is running and that the phone can reach it.</string>
    <string name="billing_error_unauthorized">The Worker rejected the device secret (HTTP 401). Check the secret above.</string>
    <string name="billing_error_worker">The Worker could not report spending: %1$s</string>
    <string name="billing_error_http">The Worker returned HTTP %1$d</string>
    <string name="billing_error_malformed">The Worker\'s answer could not be read.</string>

    <!-- Defaults seeded into settings on first run -->
    <string name="default_languages">ru,en</string>
    <string name="default_prompt">Dictation of messages and technical notes. Keep punctuation, English product names and the speaker\'s original language.</string>
    <!-- Fallback only. The real vocabulary is data/keywords.txt, baked into
         debug builds via BuildConfig.DEFAULT_KEYWORDS; this never carries personal terms. -->
    <string name="default_keywords" translatable="false">OpenAI\nChatGPT\nAndroid\nCloudflare\nWebSocket</string>
</resources>
