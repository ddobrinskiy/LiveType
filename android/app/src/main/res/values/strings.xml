    here automatically. Russian lives in values-ru/strings.xml.
-->
<resources>
    <string name="app_name">LiveType</string>
    <string name="ime_name">LiveType Voice Input</string>
    <string name="app_tagline">Voice input via OpenAI gpt-live-transcribe</string>

    <!-- Keyboard status line -->
    <!-- status_ready is shown only once the OpenAI socket is actually open. -->
    <string name="status_ready">Ready to dictate</string>
    <string name="status_not_connected">Not connected — tap the microphone</string>
    <string name="status_password_field">Dictation is disabled in password fields</string>
